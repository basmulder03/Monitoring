<Project>
  <!-- Separate output per OS: restore results hold absolute package paths, so a Linux (WSL) build and a Windows IDE must not share obj/. -->
  <PropertyGroup>
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts/$(OS)</ArtifactsPath>
  </PropertyGroup>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <!-- Package metadata; only the projects that can be packed use it (Client, Protocol). Nothing is published from here, see the release steps in #56. -->
  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Authors>Bas Mulder</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://basmulder03.github.io/Monitoring/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/basmulder03/Monitoring</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
  <!-- Production projects must stay Native AOT compatible: trim/AOT warnings fail the build. -->
  <PropertyGroup Condition="!$(MSBuildProjectName.EndsWith('.Tests'))">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
</Project>
