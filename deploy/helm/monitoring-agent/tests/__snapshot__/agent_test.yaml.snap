matches the snapshot of its default render:
  1: |
    apiVersion: apps/v1
    kind: Deployment
    metadata:
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: monitoring-agent
        app.kubernetes.io/version: 0.1.0
        helm.sh/chart: monitoring-agent-0.1.0
      name: monitoring-agent
    spec:
      replicas: 1
      selector:
        matchLabels:
          app.kubernetes.io/instance: RELEASE-NAME
          app.kubernetes.io/name: monitoring-agent
      strategy:
        type: Recreate
      template:
        metadata:
          labels:
            app.kubernetes.io/instance: RELEASE-NAME
            app.kubernetes.io/name: monitoring-agent
        spec:
          containers:
            - env:
                - name: MONITORING_Agent__ScopeName
                  value: NAMESPACE
                - name: MONITORING_Agent__Token
                  valueFrom:
                    secretKeyRef:
                      key: token
                      name: agent-token
                - name: MONITORING_Agent__Controllers__0
                  value: controller:9440
                - name: MONITORING_Agent__Discovery__Kind
                  value: kubernetes
                - name: MONITORING_Agent__Discovery__Kubernetes__MonitoringSidecarContainer
                  value: monitoring-sidecar
                - name: MONITORING_Agent__Transport__Mode
                  value: none
              image: monitoring-agent:0.1.0
              imagePullPolicy: IfNotPresent
              name: agent
              ports:
                - containerPort: 9441
                  name: sidecars
              resources:
                limits:
                  memory: 128Mi
                requests:
                  cpu: 25m
                  memory: 32Mi
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                readOnlyRootFilesystem: true
          securityContext:
            runAsNonRoot: true
            seccompProfile:
              type: RuntimeDefault
          serviceAccountName: monitoring-agent
  2: |
    apiVersion: v1
    kind: ServiceAccount
    metadata:
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: monitoring-agent
        app.kubernetes.io/version: 0.1.0
        helm.sh/chart: monitoring-agent-0.1.0
      name: monitoring-agent
  3: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: Role
    metadata:
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: monitoring-agent
        app.kubernetes.io/version: 0.1.0
        helm.sh/chart: monitoring-agent-0.1.0
      name: monitoring-agent
    rules:
      - apiGroups:
          - ""
        resources:
          - pods
        verbs:
          - get
          - list
          - watch
      - apiGroups:
          - ""
        resources:
          - events
          - services
        verbs:
          - list
      - apiGroups:
          - apps
        resources:
          - deployments
          - statefulsets
        verbs:
          - list
  4: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: RoleBinding
    metadata:
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: monitoring-agent
        app.kubernetes.io/version: 0.1.0
        helm.sh/chart: monitoring-agent-0.1.0
      name: monitoring-agent
    roleRef:
      apiGroup: rbac.authorization.k8s.io
      kind: Role
      name: monitoring-agent
    subjects:
      - kind: ServiceAccount
        name: monitoring-agent
        namespace: NAMESPACE
