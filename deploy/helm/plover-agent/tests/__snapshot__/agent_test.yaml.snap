matches the snapshot of its default render:
  1: |
    apiVersion: apps/v1
    kind: Deployment
    metadata:
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: plover-agent
        app.kubernetes.io/version: 1.0.0
        helm.sh/chart: plover-agent-1.0.0
      name: plover-agent
    spec:
      replicas: 1
      selector:
        matchLabels:
          app.kubernetes.io/instance: RELEASE-NAME
          app.kubernetes.io/name: plover-agent
      strategy:
        type: Recreate
      template:
        metadata:
          labels:
            app.kubernetes.io/instance: RELEASE-NAME
            app.kubernetes.io/name: plover-agent
        spec:
          containers:
            - env:
                - name: PLOVER_Agent__ScopeName
                  value: NAMESPACE
                - name: PLOVER_Agent__Token
                  valueFrom:
                    secretKeyRef:
                      key: token
                      name: agent-token
                - name: PLOVER_Agent__Controllers__0
                  value: controller:9440
                - name: PLOVER_Agent__Discovery__Kind
                  value: kubernetes
                - name: PLOVER_Agent__Discovery__Kubernetes__PloverSidecarContainer
                  value: plover-sidecar
                - name: PLOVER_Agent__Transport__Mode
                  value: none
              image: ghcr.io/basmulder03/plover-agent:1.0.0
              imagePullPolicy: IfNotPresent
              name: agent
              ports:
                - containerPort: 9441
                  name: sidecars
              resources:
                limits:
                  memory: 128Mi
                requests:
                  cpu: 25m
                  memory: 32Mi
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                readOnlyRootFilesystem: true
          securityContext:
            runAsNonRoot: true
            seccompProfile:
              type: RuntimeDefault
          serviceAccountName: plover-agent
  2: |
    apiVersion: networking.k8s.io/v1
    kind: NetworkPolicy
    metadata:
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: plover-agent
        app.kubernetes.io/version: 1.0.0
        helm.sh/chart: plover-agent-1.0.0
      name: plover-agent
    spec:
      ingress:
        - from:
            - podSelector: {}
          ports:
            - port: sidecars
              protocol: TCP
      podSelector:
        matchLabels:
          app.kubernetes.io/instance: RELEASE-NAME
          app.kubernetes.io/name: plover-agent
      policyTypes:
        - Ingress
  3: |
    apiVersion: v1
    kind: ServiceAccount
    metadata:
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: plover-agent
        app.kubernetes.io/version: 1.0.0
        helm.sh/chart: plover-agent-1.0.0
      name: plover-agent
  4: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: Role
    metadata:
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: plover-agent
        app.kubernetes.io/version: 1.0.0
        helm.sh/chart: plover-agent-1.0.0
      name: plover-agent
    rules:
      - apiGroups:
          - ""
        resources:
          - pods
        verbs:
          - get
          - list
          - watch
      - apiGroups:
          - ""
        resources:
          - events
          - services
        verbs:
          - list
      - apiGroups:
          - apps
        resources:
          - deployments
          - statefulsets
        verbs:
          - list
  5: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: RoleBinding
    metadata:
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: plover-agent
        app.kubernetes.io/version: 1.0.0
        helm.sh/chart: plover-agent-1.0.0
      name: plover-agent
    roleRef:
      apiGroup: rbac.authorization.k8s.io
      kind: Role
      name: plover-agent
    subjects:
      - kind: ServiceAccount
        name: plover-agent
        namespace: NAMESPACE
