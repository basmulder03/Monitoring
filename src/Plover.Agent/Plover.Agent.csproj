<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\Plover.Protocol\Plover.Protocol.csproj" />
    <ProjectReference Include="..\Plover.Hosting\Plover.Hosting.csproj" />
    <ProjectReference Include="..\Plover.Common\Plover.Common.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.14" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.14" />
  </ItemGroup>
  <PropertyGroup>
    <PublishAot>true</PublishAot>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Plover.Agent.Tests" />
    <InternalsVisibleTo Include="Plover.Component.Tests" />
  </ItemGroup>
</Project>
