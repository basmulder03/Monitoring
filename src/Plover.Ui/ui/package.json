{
  "name": "plover-ui",
  "private": true,
  "version": "0.0.0",
  "description": "The dashboard of the monitoring system: TypeScript and Preact, bundled by esbuild into the assets the controller embeds.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && node build.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "preact": "^11.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
