<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
    <UiDirectory>$(MSBuildProjectDirectory)/ui</UiDirectory>
    <UiOutput>$(MSBuildProjectDirectory)/wwwroot</UiOutput>
  </PropertyGroup>

  <ItemGroup>
    <UiSource Include="ui/src/**;ui/public/**;ui/build.mjs;ui/package.json;ui/package-lock.json;ui/tsconfig.json" />
  </ItemGroup>

  <!-- The dashboard is TypeScript. It is type-checked and bundled into wwwroot, which is embedded in this assembly, so the controller stays one executable.
       Node and npm are needed to build; the build says so when they are missing. Behind a proxy that inspects TLS, see docs/testing.md. -->
  <Target Name="BuildDashboard" BeforeTargets="AssignTargetPaths" Inputs="@(UiSource)" Outputs="$(UiOutput)/app.js;$(UiOutput)/styles.css;$(UiOutput)/index.html;$(UiOutput)/logo.svg">
    <Exec Command="npm --version" ContinueOnError="true" StandardOutputImportance="low" StandardErrorImportance="low" IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="NpmCheck" />
    </Exec>
    <Error Condition="'$(NpmCheck)' != '0'"
           Text="Node.js and npm are needed to build the dashboard (src/Plover.Ui/ui). Install Node 22 or later; see docs/testing.md." />
    <Exec Command="npm ci" WorkingDirectory="$(UiDirectory)" Condition="!Exists('$(UiDirectory)/node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(UiDirectory)" />
  </Target>

  <!-- The files are written by the target above, so they are added after it ran rather than by a pattern at the start of the build. -->
  <Target Name="EmbedDashboard" AfterTargets="BuildDashboard" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <DashboardFile Include="wwwroot/**" />
      <EmbeddedResource Include="@(DashboardFile)" LogicalName="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>
  </Target>
</Project>
