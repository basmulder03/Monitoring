<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\Monitoring.Protocol\Monitoring.Protocol.csproj" />
    <ProjectReference Include="..\Monitoring.Common\Monitoring.Common.csproj" />
    <ProjectReference Include="..\Monitoring.Hosting\Monitoring.Hosting.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <PublishAot>true</PublishAot>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Monitoring.Sidecar.Tests" />
    <InternalsVisibleTo Include="Monitoring.Component.Tests" />
  </ItemGroup>
</Project>
