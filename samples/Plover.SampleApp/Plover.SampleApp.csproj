<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <PublishAot>true</PublishAot>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <!-- A package of its own, so there is something to list; the shared framework is not a package. -->
    <PackageReference Include="Polly.Core" Version="8.8.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- In your own application this is a package reference to Plover.Client; the targets come with the package. -->
    <ProjectReference Include="..\..\src\Plover.Client\Plover.Client.csproj" />
  </ItemGroup>
  <Import Project="..\..\src\Plover.Client\build\Plover.Client.targets" />
</Project>
